   "source": [
    "# Given values\n",
    "n = 10\n",
    "s = 5.2\n",
    "sigma0 = 4\n",
    "\n",
    "# Test statistic\n",
    "chi2 = (n - 1) * s^2 / sigma0^2\n",
    "chi2\n",
    "\n",
    "# Degrees of freedom\n",
    "df = n - 1\n",
    "\n",
    "# Right-tailed p-value\n",
    "p_value = 1 - pchisq(chi2, df)\n",
    "round(p_value, 3)\n"
   ]
  },
